# Optional: LI.FI API Key for higher rate limits
# Get your API key at https://portal.li.fi/
LIFI_API_KEY=your_api_key_here

# Required for execute-real-transaction.ts: Execute real transactions
PRIVATE_KEY=0xYourPrivateKeyHere
FROM_ADDRESS=0xYourWalletAddressHere
WALLET_ADDRESS=0xYourWalletAddressHere

RPC_ETH=https://mainnet.infura.io/v3/<metamask developer API_KEY>
RPC_ARB=https://arb-mainnet.g.alchemy.com/v2/<alchemy_API_KEY>
RPC_BASE=https://base-mainnet.g.alchemy.com/v2/<alchemy_API_KEY>
RPC_POLYGON=https://polygon-mainnet.g.alchemy.com/v2/<alchemy_API_KEY>